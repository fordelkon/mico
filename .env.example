# Copy this file to `.env` (gitignored) and fill in the values you need.
# `.env` is loaded automatically by tests/e2e/global-setup.ts; real
# environment variables win over `.env` entries.

# Real LLM endpoints for tests/e2e/specs/real-provider.spec.ts.
# One shared API key; each protocol's test runs only when its base URL and
# model are uncommented, so enable one or both.
MICO_E2E_API_KEY=
MICO_E2E_ANTHROPIC_BASE_URL=https://api.anthropic.com
MICO_E2E_ANTHROPIC_MODEL=claude-haiku-4-5
MICO_E2E_OPENAI_BASE_URL=https://api.openai.com/v1
MICO_E2E_OPENAI_MODEL=gpt-4o-mini
