{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src"],
  "exclude": [
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ],
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "noEmit": true
  }
}
