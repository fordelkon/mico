{
  "extends": "./tsconfig.json",
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "test",
    "vitest.config.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"]
  }
}
