    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "29.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "storybook": "10.2.9",
    "typescript": "^5.9.3",
    "vite": "7.2.6",
    "vitest": "4.1.6"
